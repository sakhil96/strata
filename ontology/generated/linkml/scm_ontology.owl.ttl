scm:source_systems a owl:DatatypeProperty .

scm:Part a owl:Class ;
    rdfs:label "Part" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:base_uom ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:weight_kg ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:weight_kg ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:part_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:pallet_factor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:part_family ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:base_uom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:base_uom ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:pack_factor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:pallet_factor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:part_family ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:source_systems ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:pack_factor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:part_family ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:part_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:weight_kg ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:pallet_factor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:source_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:part_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:pack_factor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:category ] ;
    skos:definition "A stock-keeping unit that can be purchased, stored, and sold." ;
    skos:exactMatch iof_scro:MaterialProduct ;
    skos:inScheme <https://scm-ontology.example.com/schema> .


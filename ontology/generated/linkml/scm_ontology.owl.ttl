@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iof_scro: <https://spec.industrialontologies.org/ontology/supplychain/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scm: <https://scm-ontology.example.com/schema/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://scm-ontology.example.com/schema.owl.ttl> a owl:Ontology ;
    rdfs:label "scm_ontology" ;
    dcterms:title "Supply Chain Ontology" ;
    skos:definition "An enterprise supply chain ontology covering procurement, logistics, inventory and sales order fulfilment. Entities map to the IOF Supply Chain Reference Ontology where a class exists." .

scm:DeliveryEvent a owl:Class ;
    rdfs:label "DeliveryEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:event_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:event_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:shipment_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:Shipment ;
            owl:onProperty scm:shipment_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:shipment_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty scm:event_time_utc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:event_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:event_time_utc ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:event_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:site_tz ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:location_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:event_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:site_tz ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:site_tz ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:location_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:event_time_utc ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:event_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:location_id ] ;
    skos:definition "A timestamped event in the lifecycle of a shipment." ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:FxRate a owl:Class ;
    rdfs:label "FxRate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:fx_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:fx_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:from_currency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:to_currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:to_currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:from_currency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:fx_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:rate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:rate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:to_currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:rate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:from_currency ] ;
    skos:definition "A daily foreign exchange rate to USD; keyed by date and source currency." ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:GoodsReceipt a owl:Class ;
    rdfs:label "GoodsReceipt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:received_qty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:receipt_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:po_line_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:quality_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:quality_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:quality_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:PurchaseOrderLine ;
            owl:onProperty scm:po_line_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:received_qty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:receipt_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:po_line_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:receipt_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:receipt_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:receipt_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:received_qty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:receipt_id ] ;
    skos:definition "A record of parts received against a purchase order line." ;
    skos:exactMatch iof_scro:GoodsReceipt ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:InventorySnapshot a owl:Class ;
    rdfs:label "InventorySnapshot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom scm:Part ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:in_transit_qty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:on_hand_value_std ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:StorageLocation ;
            owl:onProperty scm:storage_location_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:allocated_qty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:on_hand_value_std ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:allocated_qty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:in_transit_qty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:snapshot_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:on_hand_qty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:allocated_qty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:snapshot_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:on_hand_qty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:on_hand_qty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:storage_location_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:on_hand_value_std ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:in_transit_qty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:storage_location_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:snapshot_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:part_id ] ;
    skos:definition "A daily snapshot of inventory at a storage location for a part." ;
    skos:exactMatch iof_scro:InventoryPosition ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:ShipmentLine a owl:Class ;
    rdfs:label "ShipmentLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:shipped_qty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scm:is_first_shipment ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:SalesOrderLine ;
            owl:onProperty scm:so_line_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:is_first_shipment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:shipment_line_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:shipment_line_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:shipment_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:so_line_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:shipped_qty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:shipped_qty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:shipment_line_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:Shipment ;
            owl:onProperty scm:shipment_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:is_first_shipment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:shipment_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:so_line_id ] ;
    skos:definition "Links a sales order line to a shipment with the shipped quantity." ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:SupplierPartAgreement a owl:Class ;
    rdfs:label "SupplierPartAgreement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:agreement_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:currency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:unit_cost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:incoterm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty scm:quoted_lead_days ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:effective_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:Supplier ;
            owl:onProperty scm:supplier_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:Part ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:effective_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:quoted_lead_days ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:effective_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:effective_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:agreement_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:supplier_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:effective_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:unit_cost ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:incoterm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:currency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:supplier_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:effective_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:quoted_lead_days ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:incoterm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:agreement_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:currency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:unit_cost ] ;
    skos:definition "A contractual agreement for a supplier to supply a specific part." ;
    skos:exactMatch iof_scro:SupplyAgreement ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:TariffCode a owl:Class ;
    rdfs:label "TariffCode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:effective_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty scm:duty_rate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:duty_rate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:duty_rate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:hts_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:tariff_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:hts_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:hts_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:tariff_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom scm:Part ;
            owl:onProperty scm:part_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:tariff_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:effective_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:effective_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty scm:effective_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:effective_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:effective_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:part_id ] ;
    skos:definition "An HTS tariff classification with duty rates and effective dates." ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:Carrier a owl:Class ;
    rdfs:label "Carrier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:carrier_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:scac_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:carrier_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:carrier_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:carrier_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:scac_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:carrier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:carrier_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:scac_code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:carrier_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:carrier_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:carrier_type ] ;
    skos:definition "A freight carrier or logistics service provider." ;
    skos:exactMatch iof_scro:Carrier ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:customer_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:account_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:ship_to_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:account_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:sold_to_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:contact_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:segment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:contact_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:sold_to_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:customer_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:ship_to_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:contact_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:segment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:customer_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:customer_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:contact_email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:sold_to_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:contact_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:segment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:contact_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:ship_to_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:country_code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:customer_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:country_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:country_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:customer_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:account_id ] ;
    skos:definition "An organisation that purchases finished goods." ;
    skos:exactMatch iof_scro:Customer ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:Lane a owl:Class ;
    rdfs:label "Lane" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:destination_region ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:mode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:destination_region ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:origin_region ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scm:lane_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:transit_days_typical ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:origin_region ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:mode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:transit_days_typical ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty scm:transit_days_typical ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:destination_region ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:lane_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:origin_region ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scm:lane_id ] ;
    skos:definition "A defined transportation route between an origin and destination." ;
    skos:inScheme <https://scm-ontology.example.com/schema> .

scm:PurchaseOrderLine a owl:Class ;
    rdfs:label "PurchaseOrderLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:deliver_to_plant_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:line_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scm:order_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scm:line_number ],
